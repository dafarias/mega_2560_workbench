# macOS
.DS_Store

# Desktop C++ build output
build/
*.dSYM/
*.o

# PlatformIO (per sub-project)
.pio/
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch

# ...but keep the root desktop C++ debug config
!/.vscode/launch.json

# PlatformIO generates a .gitignore in each sub-project; the root rules above already cover it
/*/.gitignore
